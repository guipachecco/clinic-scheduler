# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o Git. Em produção, cadastre as variáveis no painel da hospedagem.

# Conexão com o PostgreSQL. Este valor aponta para o banco local do docker-compose.yml.
# Usada só pelas migrações (pnpm db:migrate) e pelos testes: é o dono das tabelas.
# O site não lê esta variável. Em produção, não a cadastre na hospedagem do app.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic_scheduler

# Um usuário do PostgreSQL para cada parte do app, criados pela migração 0011.
# O pnpm db:migrate define a senha de cada um a partir da URL. O usuário da URL
# precisa ser exatamente o indicado. Em produção, use senhas novas e fortes e
# nunca torne esses usuários donos das tabelas nem lhes dê BYPASSRLS
# (passo a passo no README, em "Implantação").
DATABASE_URL_AUTH=postgres://app_auth:app_auth_dev@localhost:5432/clinic_scheduler
DATABASE_URL_PANEL=postgres://app_panel:app_panel_dev@localhost:5432/clinic_scheduler
DATABASE_URL_CLIENT=postgres://app_client:app_client_dev@localhost:5432/clinic_scheduler
DATABASE_URL_PLATFORM=postgres://app_platform:app_platform_dev@localhost:5432/clinic_scheduler

# Segredo que assina as sessões e criptografa o segredo do 2FA (mínimo 32 caracteres).
# Gere um valor novo para cada ambiente com: openssl rand -base64 32
# Trocar o segredo encerra as sessões e invalida o 2FA já configurado.
BETTER_AUTH_SECRET=

# Endereço do site. Em produção, o domínio com https://
BETTER_AUTH_URL=http://localhost:3000

# Nível dos logs: debug, info, warn ou error.
LOG_LEVEL=info

# E-mails (confirmação de cadastro e troca de senha).
# Em produção (obrigatórios): chave da Resend (resend.com) e o remetente, de um domínio
# verificado nela, como "Zemana <nao-responda@seudominio.com.br>".
# Sem RESEND_API_KEY nada é enviado: cada e-mail vira um arquivo JSON na pasta
# EMAIL_OUTBOX_DIR (padrão .emails/, fora do Git).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_OUTBOX_DIR=.emails
