# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o Git. Em produção, cadastre as variáveis no painel da hospedagem.

# Conexão com o PostgreSQL. Este valor aponta para o banco local do docker-compose.yml.
# Usada só pelas migrações (pnpm db:migrate) e pelos testes: é o dono das tabelas.
# O site não lê esta variável. Em produção, não a cadastre na hospedagem do app.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic_scheduler

# Um usuário do PostgreSQL para cada parte do app, criados pela migração 0011.
# O pnpm db:migrate define a senha de cada um a partir da URL. O usuário da URL
# precisa ser exatamente o indicado. Em produção, use senhas novas e fortes e
# nunca torne esses usuários donos das tabelas nem lhes dê BYPASSRLS
# (passo a passo no README, em "Implantação").
DATABASE_URL_AUTH=postgres://app_auth:app_auth_dev@localhost:5432/clinic_scheduler
DATABASE_URL_PANEL=postgres://app_panel:app_panel_dev@localhost:5432/clinic_scheduler
DATABASE_URL_CLIENT=postgres://app_client:app_client_dev@localhost:5432/clinic_scheduler
DATABASE_URL_PLATFORM=postgres://app_platform:app_platform_dev@localhost:5432/clinic_scheduler

# Segredo que assina as sessões e criptografa o segredo do 2FA (mínimo 32 caracteres).
# Gere um valor novo para cada ambiente com: openssl rand -base64 32
# Trocar o segredo encerra as sessões e invalida o 2FA já configurado.
BETTER_AUTH_SECRET=

# Endereço do site. Em produção, o domínio com https://
BETTER_AUTH_URL=http://localhost:3000

# Nível dos logs: debug, info, warn ou error.
LOG_LEVEL=info

# E-mails (confirmação de cadastro e troca de senha).
# Em produção (obrigatórios): chave da MailerSend (mailersend.com) e o remetente, de um domínio
# verificado nela, como "Zemana <nao-responda@seudominio.com.br>".
# Sem MAILERSEND_API_KEY nada é enviado: cada e-mail vira um arquivo JSON na pasta
# EMAIL_OUTBOX_DIR (padrão .emails/, fora do Git).
MAILERSEND_API_KEY=
EMAIL_FROM=
EMAIL_OUTBOX_DIR=.emails

# Mercado Pago (docs/mercado-pago.md): cada clínica conecta a própria conta e
# recebe nela. Valores da aplicação da Zemana em mercadopago.com.br/developers:
# o "Número da aplicação" (Client ID) e o Client Secret, nas credenciais de produção.
# Sem MP_CLIENT_ID, o painel não mostra "Conectar Mercado Pago".
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Chave secreta das notificações (Webhooks > Configurar notificações, na aplicação).
# Sem ela, o sistema recusa todo aviso de pagamento.
MP_WEBHOOK_SECRET=

# Asaas — cada dona conecta a própria conta colando a chave dela na tela
# Sinal por Pix; não há chave da Zemana. O recurso liga quando
# ASAAS_WEBHOOK_TOKEN está definido.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que o Asaas devolve no cabeçalho asaas-access-token de cada aviso.
# Gere um valor aleatório (32+ caracteres). Sem ele, o recurso fica desligado.
ASAAS_WEBHOOK_TOKEN=

# Lembrete por WhatsApp 1 dia antes (docs/lembrete-whatsapp.md), pela API oficial
# da Meta (WhatsApp Cloud API), do número da Zemana. Sem WHATSAPP_TOKEN nada é
# enviado: cada mensagem vira um arquivo JSON em WHATSAPP_OUTBOX_DIR e, no site
# de verdade, o checkbox "Me avise 1 dia antes" fica escondido.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome e idioma do modelo aprovado na Meta, e a versão da Graph API.
WHATSAPP_TEMPLATE=lembrete_horario
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_OUTBOX_DIR=.whatsapp
# Webhook da Meta: URL https://<site>/api/webhooks/whatsapp. O verify token
# (32+ caracteres) é o mesmo digitado em "Verificar token" no painel do app; o
# app secret fica em Configurações do app → Básico → Chave secreta do app.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Z-API Omni (WhatsApp não oficial, por QR code): ponte enquanto a Meta está
# bloqueada. Só é usada sem WHATSAPP_TOKEN; manda o lembrete como texto.
# ZAPI_INSTANCE_ID = "ID do canal", ZAPI_TOKEN = Secret Key (painel Omni → Administração → Segurança), não o Token do canal.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Segredo do cron da Vercel (32+ caracteres). A Vercel manda
# "Authorization: Bearer <CRON_SECRET>" para /api/cron/lembretes.
CRON_SECRET=
