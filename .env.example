# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o Git. Em produção, cadastre as variáveis no painel da hospedagem.

# Conexão com o PostgreSQL. Este valor aponta para o banco local do docker-compose.yml.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic_scheduler

# Segredo que assina as sessões e criptografa o segredo do 2FA (mínimo 32 caracteres).
# Gere um valor novo para cada ambiente com: openssl rand -base64 32
# Trocar o segredo encerra as sessões e invalida o 2FA já configurado.
BETTER_AUTH_SECRET=

# Endereço do site. Em produção, o domínio com https://
BETTER_AUTH_URL=http://localhost:3000

# Nível dos logs: debug, info, warn ou error.
LOG_LEVEL=info
